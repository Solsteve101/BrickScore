# Copy this file to .env.local and fill in the values.

# --- Database (Prisma) ---
DATABASE_URL=your_database_url
DIRECT_URL=your_direct_database_url

# --- Auth (NextAuth v5) ---
# Read implicitly by NextAuth; generate with: npx auth secret
AUTH_SECRET=your_auth_secret
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- AI / Scraping ---
ANTHROPIC_API_KEY=your_anthropic_api_key
FIRECRAWL_API_KEY=your_firecrawl_api_key

# --- Email (Resend) ---
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=your_sender_address

# --- Stripe ---
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=your_price_id
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=your_price_id
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS_MONTHLY=your_price_id
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS_YEARLY=your_price_id

# --- Cron ---
CRON_SECRET=your_cron_secret
